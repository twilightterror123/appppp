# NEW AI runtime
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*
NEWAI_DB=newai.db
NEWAI_ADMIN_KEY=CHANGE_THIS_LONG_RANDOM_ADMIN_KEY

# Option A: local model, e.g. Ollama's OpenAI-compatible endpoint
PROVIDER_BASE_URL=http://localhost:11434/v1
PROVIDER_API_KEY=ollama
MODEL=llama3.2:3b

# Option B: any OpenAI-compatible server/provider
# PROVIDER_BASE_URL=https://YOUR_PROVIDER/v1
# PROVIDER_API_KEY=YOUR_SERVER_SIDE_KEY
# MODEL=YOUR_MODEL

# Optional image backend (OpenAI-compatible)
# IMAGE_PROVIDER_URL=https://YOUR_IMAGE_PROVIDER/v1
# IMAGE_PROVIDER_KEY=YOUR_SERVER_SIDE_IMAGE_KEY
# IMAGE_MODEL=YOUR_IMAGE_MODEL

AI_TIMEOUT=180
